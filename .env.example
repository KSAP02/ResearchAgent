# Copy to .env and fill in. Never commit .env.
# Secrets and deployment values only; hyperparameters live in settings/config.toml.

# OpenAI (LLM + embeddings): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# LangSmith (tracing/evaluation, from Phase 2): https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional, later: Semantic Scholar API key (higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# arXiv needs no key.

# Backend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Storage dir for Milvus Lite + SQLite. Unset locally -> <repo>/data_warehouse; compose sets /data.
# DATA_DIR=
# Hyperparameter file. Unset locally -> <repo>/settings/config.toml; compose sets /app/settings/config.toml.
# CONFIG_PATH=

# Optional: override any config.toml value as SECTION__KEY (wins over the file), e.g.
# LLM__MODEL=gpt-4.1
