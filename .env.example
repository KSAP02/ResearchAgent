# Copy to .env and fill in. Never commit .env.

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Workflow
MAX_RESEARCH_RETRIES=2

# Storage: where Milvus Lite + SQLite files live.
# Leave unset locally -> <repo>/data_warehouse. docker-compose sets it to /data (named volume).
# DATA_DIR=

# Backend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
